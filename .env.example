# ---- Required for real data ----
# Google Cloud Console -> APIs & Services -> enable "YouTube Data API v3" -> Credentials -> API key
YOUTUBE_API_KEY=

# ---- Optional: search demand ----
# Google Trends (YouTube Search) via SerpApi: https://serpapi.com (free plan: 250 searches/month; 2 per keyword)
SERPAPI_KEY=
# Google search volume, CPC and competition via Keywords Everywhere: https://keywordseverywhere.com (1 credit per keyword)
KE_API_KEY=
# Country for volume data (defaults to the region you type, else "us"); keywords looked up per search (main + ideas)
KE_COUNTRY=
KE_MAX_KEYWORDS=20

# ---- Optional: "My channel" (your private YouTube Analytics) ----
# OAuth client (Web application) with redirect URI  <PUBLIC_URL>/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Set to 1 to also request revenue metrics (only works for channels in the YouTube Partner Program)
ENABLE_REVENUE=0

# ---- Server ----
PORT=3000
# 127.0.0.1 keeps TubeScout private to this computer. To host it, set HOST=0.0.0.0 AND APP_PASSWORD.
HOST=127.0.0.1
APP_PASSWORD=
# Public address used for the Google sign-in redirect (defaults to http://localhost:PORT)
PUBLIC_URL=
# Where tracked-channel snapshots and your Google sign-in are stored
DATA_DIR=data
