# TubeScout settings. Copy to .env and fill in what you need; restart after changes.
# Put comments on their own line (no "KEY=value # comment"). An empty value means "use the default".

# ---- YouTube data (required for real data) ----
# Google Cloud Console -> APIs & Services -> enable "YouTube Data API v3" -> Credentials -> API key.
# Empty = demo mode with synthetic channel, video and search data.
YOUTUBE_API_KEY=
# 1 = force demo mode (synthetic data) even when YOUTUBE_API_KEY is set. Default 0.
DEMO=0

# ---- Optional: search demand (Keyword research tab) ----
# Google Trends (YouTube Search) via SerpApi: https://serpapi.com (free plan: 250 searches/month; 2 per keyword)
SERPAPI_KEY=
# Google search volume, CPC and competition via Keywords Everywhere: https://keywordseverywhere.com (1 credit per keyword)
KE_API_KEY=
# Country for volume data. Empty = the region you search with, else "us".
KE_COUNTRY=
# Keyword ideas looked up per search on top of the keyword itself (0-99). Default 20.
KE_MAX_KEYWORDS=20

# ---- Optional: "My channel" (your private YouTube Analytics) ----
# OAuth client (Web application) with redirect URI  <PUBLIC_URL>/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 1 = also request revenue metrics (only works for channels in the YouTube Partner Program). Default 0.
ENABLE_REVENUE=0

# ---- Optional: AI Studio (Claude) ----
# API key from https://console.anthropic.com/ (billed per token by Anthropic). Also run "npm install". Empty = AI Studio off.
ANTHROPIC_API_KEY=
# Claude model ID. Empty = claude-opus-5-5.
AI_MODEL=
# 1 = turn AI Studio on without ANTHROPIC_API_KEY, using the Anthropic SDK's own credential lookup (e.g. a saved profile). Default 0.
AI_ENABLED=0

# ---- Optional: alert delivery (Alerts tab) ----
# Telegram: create a bot with @BotFather (/newbot), message it, then read message.chat.id from
# https://api.telegram.org/bot<TOKEN>/getUpdates. Both values are needed.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Discord or Slack incoming-webhook URL (auto-detected), or any URL that accepts a JSON POST {text, alert}
ALERT_WEBHOOK_URL=

# ---- Optional: Rankings tab ----
# Max search-rank checks (manual + automatic) per rolling 24 hours, 0-1000. Each check = 1 of the
# ~100 daily YouTube search calls + 1 API unit. 0 turns rank checks off. Default 20.
RANK_MAX_CHECKS_PER_DAY=20

# ---- Server ----
# HTTP port. Default 3000.
PORT=3000
# 127.0.0.1 keeps TubeScout private to this computer. To host it, set HOST=0.0.0.0 AND APP_PASSWORD.
HOST=127.0.0.1
# Password for the whole app (browser prompt / HTTP Basic auth, any username). Required on a non-local HOST.
APP_PASSWORD=
# Public address used for the Google sign-in redirect. Empty = RENDER_EXTERNAL_URL if set (Render sets it
# to https://<service>.onrender.com), else http://localhost:PORT
PUBLIC_URL=
# Where tracked channels, snapshots, rankings, alerts and your Google sign-in are stored. Default data.
DATA_DIR=data
# 1 = no background jobs (daily tracking snapshots, automatic rank checks); manual refreshes still work. Default 0.
DISABLE_SCHEDULER=0
